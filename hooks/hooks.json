{
  "description": "magento2-tools: block Write/Edit of .docs/ artifacts outside the project-root .docs/ directory (context artifact-location rule); warn (never block) when a magento2-tools entry point starts in a conversation above the context budget.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-docs-path.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-budget.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-budget.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
